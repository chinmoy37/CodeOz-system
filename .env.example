# ============================================================
# CodeOz Environment Variables — copy this to .env.local
# and fill in real values. Never commit .env.local to git!
# ============================================================

# ── Contact Form ────────────────────────────────────────────
# Get your Formspree form ID at https://formspree.io
VITE_FORMSPREE_URL=https://formspree.io/f/YOUR_FORM_ID

# ── Contact Info (shown in UI) ───────────────────────────────
VITE_CONTACT_EMAIL=contact@codeoz.org
VITE_CONTACT_PHONE=+880 1700-000000
VITE_WHATSAPP_NUMBER=8801700000000

# ── Social Links ─────────────────────────────────────────────
VITE_SOCIAL_LINKEDIN=https://linkedin.com/company/codeoz
VITE_SOCIAL_GITHUB=https://github.com/codeoz
VITE_SOCIAL_TWITTER=https://twitter.com/codeoz

# ── Site URL (used in SEO/sitemap) ──────────────────────────
VITE_SITE_URL=https://codeoz.org

# ── Analytics (optional) ─────────────────────────────────────
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
