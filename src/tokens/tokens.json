{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "CodeOZ Design Tokens",
  "version": "1.0.0",
  "color": {
    "brand": {
      "solarOrange": { "value": "#FF6A00", "description": "Primary brand color for CodeOZ orbit and accent marks" },
      "solarOrangeHover": { "value": "#FF7D20", "description": "Hover state for solar orange" },
      "solarOrangeMuted": { "value": "rgba(255, 106, 0, 0.15)", "description": "Soft tinted background for badges" }
    },
    "foundation": {
      "midnight950": { "value": "#07030E", "description": "Deepest space abyss background" },
      "midnight900": { "value": "#0D061A", "description": "Primary dark mode background" },
      "midnight850": { "value": "#130A24", "description": "Dark container and card surface" },
      "midnight800": { "value": "#1B0E33", "description": "Elevated dark container and dropdowns" },
      "midnight700": { "value": "#261547", "description": "Dark mode border and subtle dividers" },
      "midnight600": { "value": "#382063", "description": "Active dark state and hover borders" }
    },
    "accent": {
      "lime": { "value": "#CCFF00", "description": "Electric lime signature highlight (Aurora accents, tags, CTA)" },
      "limeLight": { "value": "#E0FF66", "description": "Hover state for electric lime" },
      "limeDark": { "value": "#A8D400", "description": "Active/pressed state for electric lime" },
      "limeGlow": { "value": "rgba(204, 255, 0, 0.35)", "description": "Subtle neon emission" },
      "pinkNeon": { "value": "#FF007A", "description": "Hot pink secondary decorative accent" },
      "pinkGlow": { "value": "rgba(255, 0, 122, 0.35)", "description": "Secondary neon emission" }
    },
    "light": {
      "background": { "value": "#FFFFFF", "description": "Primary light canvas" },
      "surface": { "value": "#F9F8FD", "description": "Subtle off-white light surface" },
      "card": { "value": "#FFFFFF", "description": "Clean light card surface" },
      "border": { "value": "#E8E4F2", "description": "Soft light mode border" },
      "borderStrong": { "value": "#D1C9E6", "description": "Prominent light mode divider" },
      "textPrimary": { "value": "#0D061A", "description": "Midnight violet primary light text" },
      "textMuted": { "value": "#62577A", "description": "Secondary light text" }
    },
    "semantic": {
      "success": { "value": "#10B981" },
      "warning": { "value": "#F59E0B" },
      "error": { "value": "#EF4444" },
      "info": { "value": "#3B82F6" },
      "focusRing": { "value": "#CCFF00" }
    }
  },
  "typography": {
    "fontFamily": {
      "display": { "value": "Space Grotesk, sans-serif" },
      "body": { "value": "Rubik, sans-serif" },
      "code": { "value": "JetBrains Mono, Monaco, monospace" }
    },
    "fontSize": {
      "xs": { "value": "0.75rem", "lineHeight": "1rem" },
      "sm": { "value": "0.875rem", "lineHeight": "1.25rem" },
      "base": { "value": "1rem", "lineHeight": "1.5rem" },
      "lg": { "value": "1.125rem", "lineHeight": "1.75rem" },
      "xl": { "value": "1.25rem", "lineHeight": "1.75rem" },
      "2xl": { "value": "1.5rem", "lineHeight": "2rem" },
      "3xl": { "value": "1.875rem", "lineHeight": "2.25rem" },
      "4xl": { "value": "2.25rem", "lineHeight": "2.5rem" },
      "5xl": { "value": "3rem", "lineHeight": "1.1" },
      "6xl": { "value": "3.75rem", "lineHeight": "1.05" }
    },
    "fontWeight": {
      "light": { "value": "300" },
      "regular": { "value": "400" },
      "medium": { "value": "500" },
      "semibold": { "value": "600" },
      "bold": { "value": "700" }
    }
  },
  "spacing": {
    "1": { "value": "0.25rem" },
    "2": { "value": "0.5rem" },
    "3": { "value": "0.75rem" },
    "4": { "value": "1rem" },
    "6": { "value": "1.5rem" },
    "8": { "value": "2rem" },
    "10": { "value": "2.5rem" },
    "12": { "value": "3rem" },
    "16": { "value": "4rem" },
    "20": { "value": "5rem" },
    "24": { "value": "6rem" }
  },
  "borderRadius": {
    "sm": { "value": "0.25rem" },
    "md": { "value": "0.5rem" },
    "lg": { "value": "0.75rem" },
    "xl": { "value": "1rem" },
    "2xl": { "value": "1.25rem" },
    "3xl": { "value": "1.75rem" },
    "full": { "value": "9999px" }
  },
  "elevation": {
    "sm": { "value": "0 2px 8px -2px rgba(0, 0, 0, 0.3)" },
    "md": { "value": "0 8px 24px -4px rgba(0, 0, 0, 0.45)" },
    "lg": { "value": "0 16px 40px -8px rgba(0, 0, 0, 0.6)" },
    "limeGlow": { "value": "0 0 25px rgba(204, 255, 0, 0.35)" },
    "solarGlow": { "value": "0 0 25px rgba(255, 106, 0, 0.35)" }
  },
  "transition": {
    "fast": { "value": "150ms cubic-bezier(0.4, 0, 0.2, 1)" },
    "normal": { "value": "250ms cubic-bezier(0.4, 0, 0.2, 1)" },
    "slow": { "value": "400ms cubic-bezier(0.4, 0, 0.2, 1)" }
  }
}
